# Variables utilisées lors de l’intégration Supabase, non nécessaires à la phase 1.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Numéros destinés aux abonnements Delifast : configuration serveur uniquement.
# Valeurs de démonstration non appelables; définir les vraies valeurs uniquement
# dans l’environnement sécurisé du serveur de production, jamais dans le code.
DELIFAST_ORANGE_MONEY_RECIPIENT_NUMBER=NUMERO_FICTIF_ORANGE
DELIFAST_TELMOB_RECIPIENT_NUMBER=NUMERO_FICTIF_TELMOB

# Clé strictement serveur : ne jamais la préfixer par NEXT_PUBLIC_ ni l’exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
